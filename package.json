    "@remotion/effects": "^4.0.541",
    "@remotion/enable-scss": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/gif": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/gsap": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "@remotion/light-leaks": "4.0.541",
    "@remotion/lottie": "4.0.541",
    "@remotion/mac-cursors": "4.0.541",
    "@remotion/media": "^4.0.541",
    "@remotion/media-parser": "4.0.541",
