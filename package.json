    "@remotion/rough-notation": "4.0.541",
    "@remotion/rounded-text-box": "4.0.541",
    "@remotion/sfx": "4.0.541",
    "@remotion/shapes": "4.0.541",
    "@remotion/starburst": "4.0.541",
    "@remotion/tailwind": "^4.0.541",
    "@remotion/tailwind-v4": "4.0.541",
    "@remotion/three": "^4.0.541",
    "@remotion/transitions": "4.0.541",
    "@remotion/video-matting": "4.0.541",
    "@remotion/webcodecs": "4.0.541",
    "@remotion/whisper-webgpu": "4.0.541",
    "@types/three": "^0.187.0",
    "animejs": "^3.2.2",
    "autoprefixer": "^10.6.2",
